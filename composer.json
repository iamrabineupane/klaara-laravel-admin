{
    "name": "klaara/laravel-admin",
    "description": "laravel admin (maintained fork of encore/laravel-admin for Laravel 10, 11, 12 and 13)",
    "type": "library",
    "keywords": ["laravel", "admin", "grid", "form"],
    "homepage": "https://github.com/z-song/laravel-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "zsong",
            "email": "zosong@126.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/dom-crawler": "^6.0|^7.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "conflict": {
        "encore/laravel-admin": "*"
    },
    "require-dev": {
        "laravel/laravel": "^12.0|^13.0",
        "fakerphp/faker": "^1.23",
        "intervention/image": "^2.7",
        "laravel/browser-kit-testing": "^7.2",
        "laravel/legacy-factories": "^1.4",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Klaara\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Models\\": "tests/models",
            "Tests\\Controllers\\": "tests/controllers"
        },
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "suggest": {
        "doctrine/dbal": "Only needed on a Laravel version without Schema::getColumns() (used by admin:make to read table columns).",
        "intervention/image": "Required to handling and manipulation upload images (~2.3).",
        "spatie/eloquent-sortable": "Required to built orderable gird."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Klaara\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Admin": "Klaara\\Admin\\Facades\\Admin"
            }
        }
    }
}
